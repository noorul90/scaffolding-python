[project]
name = {{project_name}}
version = {{version}}
description = "A production-grade asynchronous FastAPI enterprise layout"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    # Core API Framework
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.30.0",
    
    # Configuration and Data Validation
    "pydantic[email]>=2.7.0",
    "pydantic-settings>=2.2.0",
    
    # Database Layer
    "sqlalchemy>=2.0.30",
    "asyncpg>=0.29.0",
    "alembic>=1.13.0",
    
    # Utilities
    "typing-extensions>=4.10.0"
]

[dependency-groups]
dev = [
    # Testing Suite
    "pytest>=8.2.0",
    "pytest-asyncio>=0.23.0",
    "httpx>=0.27.0",
    "aiosqlite>=0.20.0", # Async SQLite driver for in-memory testing
    
    # Code Quality & Formatting
    "black>=24.4.0",
    "ruff>=0.4.0",
]

# Pytest Configuration Block
[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
python_files = ["test_*.py"]
filterwarnings = [
    "ignore::DeprecationWarning",
    "ignore::PendingDeprecationWarning"
]

# Formatting Tool Rules (Optional but highly recommended for production)
[tool.black]
line-length = 88
target-version = ['py311']

[tool.ruff]
line-length = 88
target-version = "py311"
lint.select = ["E", "F", "I", "N", "UP", "B"]
lint.ignore = ["D"]
